# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgresql+psycopg2://swaraj:swaraj@localhost:5432/swaraj_solar
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Dev only — use Alembic migrations in production
AUTO_CREATE_TABLES=false

# Campaign / calling
DEFAULT_TIMEZONE=Asia/Kolkata
DISPATCH_INTERVAL_SECONDS=30
# Public URL the telephony provider can reach for call status callbacks
PUBLIC_BASE_URL=
# Shared token required on /calls/webhooks/*; leave empty only in local dev
TELEPHONY_WEBHOOK_TOKEN=

# Telephony provider: "mock" places no real calls; "exotel" dials customers
TELEPHONY_PROVIDER=mock
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_FLOW_APP_ID=

# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgresql+psycopg2://swaraj:swaraj@localhost:5432/swaraj_solar
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Dev only — use Alembic migrations in production
AUTO_CREATE_TABLES=false

# Campaign / calling
DEFAULT_TIMEZONE=Asia/Kolkata
DISPATCH_INTERVAL_SECONDS=30
# Public URL the telephony provider can reach for call status callbacks
PUBLIC_BASE_URL=
# Shared token required on /calls/webhooks/*; leave empty only in local dev
TELEPHONY_WEBHOOK_TOKEN=

# Telephony provider: "mock" places no real calls; "exotel" dials customers
TELEPHONY_PROVIDER=mock
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
# Required when TELEPHONY_PROVIDER=exotel: the call flow that connects the
# answered customer to the AI agent. Without it a call has no destination.
EXOTEL_FLOW_APP_ID=
EXOTEL_STATUS_CALLBACK_EVENTS=terminal
EXOTEL_MAX_RETRIES=2
# Fail out calls whose status callback never arrives, freeing their slot
STUCK_CALL_TIMEOUT_MINUTES=30

# ---- AI voice pipeline ----
# Providers: "mock" makes no network calls and costs nothing
SPEECH_PROVIDER=mock
LLM_PROVIDER=mock
VOICE_PROVIDER=mock
DEFAULT_LANGUAGE=te-IN
MAX_CONVERSATION_TURNS=20

# Claude (LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low

# ---- Call recordings ----
# "local" writes to STORAGE_DIR; "s3" puts them in a bucket
STORAGE_PROVIDER=local
STORAGE_DIR=/var/lib/swaraj/recordings
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Download the recording the telephony provider reports on its webhook
FETCH_PROVIDER_RECORDINGS=false
# 0 keeps call audio indefinitely; set days to age it out
RECORDING_RETENTION_DAYS=0

# ---- Knowledge base / RAG ----
# "mock" is a hashed bag-of-words: offline, free, keyword-quality retrieval
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
KNOWLEDGE_TOP_K=3
KNOWLEDGE_MIN_SIMILARITY=0.25

# ElevenLabs (VOICE_PROVIDER / SPEECH_PROVIDER = elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
